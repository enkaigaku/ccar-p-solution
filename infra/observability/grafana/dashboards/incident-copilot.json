    {
      "type": "row",
      "id": 20,
      "title": "调查 trace",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 21,
      "title": "最近的调查",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "每次调查一条 trace：编排 span + Anthropic SDK 的 GenAI span + MCP server span。点击 Trace ID 打开。",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ resource.service.namespace = \"incident-copilot\" && name = \"incident.investigation\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
