    "dev:api": "pnpm --filter @incident/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1"
    }
  }
}
