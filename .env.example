# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://incident:incident@localhost:5432/incident
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to true to turn off all OTLP export (CI, tests).
OTEL_SDK_DISABLED=false
# Daily Claude budget; Grafana alerts when rolling 24h spend passes 80% of it.
LLM_DAILY_BUDGET_USD=10
API_PORT=3000
