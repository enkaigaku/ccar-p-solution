# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://incident:incident@localhost:5432/incident
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to true to turn off all OTLP export (CI, tests).
OTEL_SDK_DISABLED=false
# Daily Claude budget; Grafana alerts when rolling 24h spend passes 80% of it.
LLM_DAILY_BUDGET_USD=10
API_PORT=3000
# Console login (ADR 010). With OIDC_ISSUER set, the api verifies access tokens and the web console signs users in.
# Without it the api refuses to start unless AUTH_MODE=dev is set: then requests are NOT authenticated and every
# caller is the APPROVER_ID operator with all roles (evaluation runs, console development).
# OIDC_ISSUER=http://localhost:8080/realms/incident
# AUTH_MODE=dev
# The audience access tokens must carry, and the console's OIDC client. Defaults match infra/keycloak.
# OIDC_AUDIENCE=incident-api
# OIDC_CLIENT_ID=incident-web
# Client secret of incident-web: read by the web server and by Keycloak's realm import. Generate: openssl rand -hex 24
OIDC_CLIENT_SECRET=
# The console's public origin; redirect URIs are built from it.
# WEB_ORIGIN=http://localhost:3001
# Local Keycloak (infra/keycloak): admin console password, and the password of the demo users alice / bob / carol.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DEMO_PASSWORD=
# Host port of the local Keycloak. 8080 is also the OpenTelemetry Demo's frontend-proxy: when both run, pick another
# port here and use the same one in OIDC_ISSUER.
# KEYCLOAK_PORT=8080
# HMAC secret (>= 32 chars) shared by the api's approval executor (signs) and mcp-ops (verifies).
APPROVAL_SIGNING_KEY=
# Optional: replay recorded telemetry instead of live backends (evals). The api's mcp-observability then serves
# <OBS_REPLAY_DIR>/<alert fingerprint>/snapshot.json.
# OBS_REPLAY_DIR=
# Agent budget per investigation; once spent, the agent must answer without more tool calls.
AGENT_MAX_TURNS=12
AGENT_MAX_COST_USD=0.6
# Investigation model and effort. The defaults are the documented ones; other values are for evaluation A/B runs.
# INVESTIGATION_MODEL=claude-opus-5-5
# INVESTIGATION_EFFORT=high
# Where published postmortems are written as Markdown before they are ingested (ADR 011). Git-ignored by default.
# POSTMORTEM_CORPUS_DIR=infra/.api-state/corpus
